NODE_ENV=development
DATABASE_URL=postgres://bolinha:bolinha@localhost:5432/bolinha
API_HOST=127.0.0.1
API_PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemini-2.5-flash,deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-small-24b-instruct-2501
OPENROUTER_TIMEOUT_MS=30000
# TASK-38: Resiliência a rate limit (HTTP 429) e falhas transitórias com backoff exponencial e jitter
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_MS=1000
AI_RETRY_MAX_DELAY_MS=10000
# Confiança mínima para compras (BUY) quando decididas por modelo de fallback (default 0.70; modelos primários usam 0.50)
AI_FALLBACK_MIN_CONFIDENCE=0.70
INTERVAL_SECONDS=60
STOP_LOSS_PCT=0.012
MAX_STOP_LOSS_PCT=0.018
# Modo de Stop Loss: 'STATIC' (percentual fixo STOP_LOSS_PCT) ou 'ATR' (baseado na volatilidade real do ativo)
STOP_LOSS_MODE=STATIC
# Multiplicador da distância em ATR para o Stop Loss dinâmico (padrão 2.0x ATR)
ATR_MULTIPLIER=2.0
# Gatilho de valorização para elevar stop loss para o breakeven (+0.5%)
BREAKEVEN_TRIGGER_PCT=0.005
# Lucro líquido mínimo travado ao acionar o breakeven (+0.2% garantido)
BREAKEVEN_PROFIT_LOCK_PCT=0.002
# Distância do trailing stop a partir da máxima histórica (0.4%)
TRAILING_STOP_PCT=0.004
# Teto de lucro protegido para o stop móvel (ex: 0.015 para travar piso em até +1.5%). Opcional.
TRAILING_STOP_CAP_PCT=0.015
# Saídas Parciais Mecânicas Automáticas (Scale-out):
# Percentual de lucro para ativar parcial automática (padrão 0.006 = +0.6%)
PARTIAL_TAKE_PROFIT_TRIGGER_PCT=0.006
# Proporção da posição a liquidar na saída parcial (padrão 0.5 = 50%)
PARTIAL_TAKE_PROFIT_RATIO=0.5
# Take Profit Total Mecânico (Full TP): encerra 100% da posição automaticamente ao atingir o alvo (+1.5%)
FULL_TAKE_PROFIT_PCT=0.015
# TASK-35: economia da entrada (BUY bloqueado se alvo líquido não compensar risco/custos; 0 desativa)
MIN_REWARD_RISK_RATIO=1.0
MIN_TARGET_COST_MULTIPLE=3
MIN_STOP_ATR_MULTIPLE=1.0
# TASK-36: risco máximo por operação (fração do patrimônio; 0 desativa o sizing por risco)
RISK_PER_TRADE_PCT=0.005
# TASK-40: Time-Stop (encerramento de posição sem progresso após N minutos com PnL líquido <= 0)
TIME_STOP_ENABLED=true
TIME_STOP_MINUTES=45
# TASK-40: Entrada escalonada (fração da quantidade para teste inicial de posição; ex: 0.33 testa com 1 ação)
ENTRY_SCALING_RATIO=0.33
ENTRY_SCALING_COOLDOWN_MINUTES=5
# TASK-40: Filtro de abertura de sessão (minutos iniciais do pregão sem novas compras; 30 min protege abertura 09:00-09:30)
OPENING_NO_TRADE_MINUTES=30
# Modo de cálculo dos alvos de lucro (Take Profit e Breakeven):
# 'NET' calcula o preço exigido para entregar o lucro líquido real após taxas B3 (emolumentos + slippage) e IR (20%);
# 'GROSS' considera apenas a variação percentual bruta do preço de mercado.
PROFIT_TARGET_CALCULATION_MODE=NET
# Alíquota de Imposto de Renda para operações de Day Trade (20% sobre o ganho líquido)
DAY_TRADE_TAX_RATE=0.20
SYMBOL=PETR4
# Cesta de ações líquidas da B3 monitoradas pelo scanner intradiário
SYMBOLS=PETR4,VALE3,ITUB4,BBDC4,BBAS3
# Multi-timeframe entry (BUY) confluence filter: EMA9 > EMA21 and RSI not overbought
# on the configured timeframes. Missing/insufficient data always results in HOLD.
ENTRY_FILTER_ENABLED=true
ENTRY_TIMEFRAMES=1m,5m,15m
ENTRY_MIN_CONFLUENT_TIMEFRAMES=2
ENTRY_RSI_OVERBOUGHT=65
# TASK-37: Nível mínimo de RSI (ex: 35) para rejeitar compras em queda livre / faca caindo (0 desativa)
ENTRY_RSI_OVERSOLD=0
# TASK-37: Extensão máxima permitida do preço acima da VWAP (ex: 0.015 = +1.5%; 0 desativa)
ENTRY_MAX_VWAP_DISTANCE_PCT=0
# TASK-37: Extensão máxima permitida do preço acima da EMA21 (ex: 0.015 = +1.5%; 0 desativa)
ENTRY_MAX_EMA_DISTANCE_PCT=0
ENTRY_REQUIRE_VWAP_ABOVE=true
# Banca inicial em BRL do paper broker da B3 e do ledger PostgreSQL no bootstrap.
# Deve ser numérica e > 0 (validada no schema Zod de @bolinha/core e no deploy).
INITIAL_BANK_BRL=100
# Limite Diário de Perda (Daily Loss Limit / Circuit Breaker).
# Trava novas compras (BUY) quando o prejuízo acumulado no dia atinge o limite.
# Percentual relativo à banca inicial (ex: 0.05 para 5%) ou valor fixo em R$ (DAILY_MAX_LOSS_BRL).
DAILY_MAX_LOSS_PCT=0.05
# DAILY_MAX_LOSS_BRL=10.00
# Teto de alocação por posição (1 a 100%) usado pelo motor de risco quando a linha
# de `trading_configuration` do PostgreSQL (autoritativa em runtime) não estiver disponível.
MAX_POSITION_PERCENT=100
# Alias legado de INITIAL_BANK_BRL (época Binance/USDT). Continua aceito, mas só é
# usado quando INITIAL_BANK_BRL está ausente; prefira sempre INITIAL_BANK_BRL.
# INITIAL_BANK_USDT=100
TRADING_LOOP_ENABLED=false
# Synthetic B3 market model (packages/exchange/src/b3/market-data.ts).
# Models intraday momentum waves: a drift that persists for a whole segment of
# candles (~SYNTHETIC_TREND_SEGMENT_CANDLES), may flip sign on the next segment
# (SYNTHETIC_REGIME_FLIP_PROBABILITY) or go sideways
# (SYNTHETIC_CONSOLIDATION_PROBABILITY), plus a weak pull back to the anchor
# price (SYNTHETIC_MEAN_REVERSION). Prices are clamped to
# +/-SYNTHETIC_PRICE_BOUND_PCT around the anchor, so the walk never runs away.
# SYNTHETIC_SEED=0 uses fresh entropy; a positive integer replays the same series.
SYNTHETIC_VOLATILITY=0.001
SYNTHETIC_MOMENTUM_DRIFT=0.00075
SYNTHETIC_TREND_SEGMENT_CANDLES=26
SYNTHETIC_REGIME_FLIP_PROBABILITY=0.6
SYNTHETIC_CONSOLIDATION_PROBABILITY=0.15
SYNTHETIC_PULLBACK_PROBABILITY=0.3
SYNTHETIC_MAX_TREND_RUN=12
SYNTHETIC_MEAN_REVERSION=0.014
SYNTHETIC_PRICE_BOUND_PCT=0.08
SYNTHETIC_SEED=0

# Headroom extra (sobre slippage 0,05% + emolumentos 0,03% já reservados) que o motor
# de risco adiciona ao dimensionar um BUY. Fail-closed: valores maiores apenas reduzem
# a quantidade comprada. Nunca abaixo de 0 (0.001 = 0,10%).
RISK_BUY_COST_BUFFER_PCT=0.001

# Ingestão em Tempo Real (WebSocket / Ticks B3 ou MT5 Bridge)
WS_ENABLED=false
WS_HOST=127.0.0.1
WS_PORT=8080
WS_PATH=/ws/ticks
